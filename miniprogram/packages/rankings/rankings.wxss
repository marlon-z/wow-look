page {
  background: #09070d;
  color: #e8e4dc;
}

.rankings-page {
  min-height: 100vh;
  padding: 36rpx 24rpx 64rpx;
  background:
    radial-gradient(circle at 50% -10%, rgba(119, 72, 151, 0.25), transparent 42%),
    linear-gradient(rgba(212, 168, 75, 0.035) 1rpx, transparent 1rpx),
    #09070d;
  background-size: auto, 48rpx 48rpx, auto;
}

.ranking-title-block {
  padding: 34rpx 16rpx 38rpx;
}

.ranking-picker-back {
  display: inline-flex;
  align-items: center;
  min-height: 50rpx;
  padding: 0 16rpx 0 6rpx;
  color: #b5a486;
  font-size: 23rpx;
}

.ranking-title {
  display: block;
  color: #f3e6c3;
  font-size: 42rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.ranking-subtitle,
.ranking-update {
  display: block;
  margin-top: 10rpx;
  color: #887d70;
  font-size: 23rpx;
  font-weight: 600;
}

.class-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.class-card {
  width: calc((100% - 48rpx) / 4);
  min-height: 158rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10rpx;
  border: 1rpx solid rgba(212, 168, 75, 0.2);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(34, 29, 42, 0.92), rgba(17, 14, 22, 0.98));
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.06), 0 8rpx 18rpx rgba(0, 0, 0, 0.22);
}

.class-card:active { transform: scale(0.97); border-color: rgba(232, 190, 92, 0.62); }
.class-emblem { width: 72rpx; height: 72rpx; }
.class-name { font-size: 24rpx; font-weight: 800; }

.ranking-header {
  position: relative;
  min-height: 132rpx;
  padding: 10rpx 0 18rpx;
}

.ranking-back {
  display: inline-flex;
  align-items: center;
  min-height: 50rpx;
  padding: 0 16rpx 0 6rpx;
  color: #b5a486;
  font-size: 23rpx;
}

.ranking-back-arrow { margin-right: 6rpx; font-size: 42rpx; font-weight: 300; line-height: 1; }
.ranking-class-title { display: flex; align-items: center; gap: 14rpx; margin-top: 4rpx; }
.ranking-class-emblem { width: 56rpx; height: 56rpx; }
.ranking-class-name { display: block; margin-top: 2rpx; color: #c9b795; font-size: 22rpx; font-weight: 700; }
.ranking-update { position: absolute; right: 2rpx; bottom: 24rpx; color: #4bbfd6; font-size: 20rpx; }

.spec-bar {
  display: flex;
  gap: 12rpx;
  padding: 10rpx 2rpx 20rpx;
}

.spec-pill,
.content-tab,
.compact-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #93897b;
  font-weight: 800;
}

.spec-pill {
  height: 52rpx;
  min-width: 94rpx;
  padding: 0 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: rgba(27, 23, 33, 0.88);
  font-size: 24rpx;
}

.spec-pill.active { color: #ffd05a; border-color: rgba(235, 184, 62, 0.58); background: rgba(118, 76, 27, 0.3); }

.compact-filter-card {
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(212, 168, 75, 0.2);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(29, 24, 36, 0.92), rgba(16, 13, 21, 0.96));
}

.content-tabs { display: flex; padding: 8rpx; gap: 8rpx; }
.content-tab { flex: 1; height: 58rpx; border-radius: 12rpx; font-size: 26rpx; }
.content-tab.active { color: #f9d47e; background: linear-gradient(180deg, rgba(130, 88, 35, 0.66), rgba(75, 49, 27, 0.72)); box-shadow: inset 0 0 0 1rpx rgba(255, 208, 90, 0.46); }

.compact-scroll { width: 100%; padding: 6rpx 0 8rpx; white-space: nowrap; }
.dungeon-scroll { border-top: 1rpx solid rgba(255, 255, 255, 0.05); }
.compact-row { display: inline-flex; min-width: 100%; gap: 10rpx; padding: 0 14rpx; }
.compact-pill { height: 46rpx; padding: 0 18rpx; border-radius: 99rpx; background: rgba(255, 255, 255, 0.035); border: 1rpx solid rgba(255, 255, 255, 0.07); font-size: 22rpx; }
.compact-pill.active { color: #f5cf73; border-color: rgba(238, 186, 67, 0.5); background: rgba(138, 87, 32, 0.25); }
.dungeon-pill { color: #a9a097; }

.ranking-state {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #877c70;
  font-size: 25rpx;
}

.loading-orb { width: 34rpx; height: 34rpx; border: 3rpx solid rgba(212, 168, 75, 0.16); border-top-color: #d4a84b; border-radius: 50%; animation: ranking-spin 0.8s linear infinite; }
@keyframes ranking-spin { to { transform: rotate(360deg); } }

.preset-list { padding-top: 2rpx; }
.preset-group { margin-bottom: 22rpx; }
.preset-group-title { display: block; padding: 6rpx 8rpx 14rpx; color: #e0bd68; font-size: 25rpx; font-weight: 900; }
.preset-card { position: relative; display: flex; align-items: center; min-height: 112rpx; margin-bottom: 12rpx; padding: 20rpx 132rpx 20rpx 22rpx; border: 1rpx solid rgba(255, 255, 255, 0.08); border-radius: 18rpx; background: linear-gradient(135deg, rgba(39, 31, 48, 0.94), rgba(17, 14, 23, 0.98)); box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.045), 0 9rpx 22rpx rgba(0, 0, 0, 0.2); }
.preset-card:active { transform: scale(0.988); border-color: rgba(212, 168, 75, 0.45); }
.preset-main { min-width: 0; flex: 1; }
.preset-name { display: block; overflow: hidden; color: #c56cff; font-size: 29rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.preset-meta { display: block; overflow: hidden; margin-top: 9rpx; color: #9d9589; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.preset-side { width: 88rpx; display: flex; align-items: flex-end; flex-direction: column; gap: 6rpx; margin-left: 12rpx; }
.preset-score { color: #efc45e; font-size: 22rpx; font-weight: 900; }
.preset-difficulty { color: #81776c; font-size: 20rpx; }
.preset-share { position: absolute; right: 16rpx; top: 50%; width: 76rpx; height: 52rpx; margin: 0; padding: 0; transform: translateY(-50%); border: 1rpx solid rgba(212, 168, 75, 0.36); border-radius: 12rpx; background: rgba(212, 168, 75, 0.08); color: #dfc281; font-size: 21rpx; font-weight: 800; line-height: 50rpx; }
.preset-share::after { border: 0; }
