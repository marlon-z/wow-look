.build-page {
  position: relative;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 0 20rpx;
  background: transparent;
}

/* ── Header ── */
.build-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.build-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #f3e6c3;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.8);
}

.build-subtitle {
  font-size: 26rpx;
  color: #a69882;
  margin-top: 12rpx;
  letter-spacing: 3rpx;
}

.build-back {
  position: absolute;
  left: 28rpx;
  top: 48rpx;
  font-size: 28rpx;
  color: #d4a84b;
  font-weight: 700;
}

/* ── Class Grid (matches index page) ── */
.class-grid-wrap {
  width: 100%;
}

.class-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.class-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 16rpx;
  border-radius: 20rpx;
  background: rgba(13, 10, 18, 0.8);
  border: 1rpx solid rgba(212, 168, 75, 0.25);
  box-shadow:
    0 8rpx 16rpx rgba(0, 0, 0, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  transition: transform 0.15s, border-color 0.15s;
}

.class-cell:active {
  transform: scale(0.96);
  border-color: rgba(212, 168, 75, 0.6);
}

.class-emblem {
  width: 104rpx;
  height: 104rpx;
  margin-bottom: 20rpx;
}

.class-label {
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* ── Build Top Bar ── */
.build-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 12rpx 8rpx;
}

.build-top-left {
  flex: 1;
  min-width: 0;
}

.build-class-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #f3e6c3;
  letter-spacing: 2rpx;
}

.build-draft-badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffa940;
  background: rgba(255, 169, 64, 0.12);
  border: 1rpx solid rgba(255, 169, 64, 0.35);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-left: 12rpx;
  vertical-align: middle;
}

.build-top-right {
  display: flex;
  gap: 12rpx;
}

.build-top-btn {
  font-size: 22rpx;
  color: #d4a84b;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(212, 168, 75, 0.4);
  border-radius: 24rpx;
  background: rgba(13, 10, 18, 0.6);
}

.build-top-btn:active {
  background: rgba(212, 168, 75, 0.15);
}

.build-name-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 12rpx 16rpx;
}

.build-plan-name {
  font-size: 24rpx;
  color: #a69882;
  font-weight: 600;
}

.build-avg-ilvl {
  font-size: 24rpx;
  color: #d4a84b;
  font-weight: 700;
}

/* ── Spec Switch Bar ── */
.spec-switch-bar {
  display: flex;
  gap: 12rpx;
  padding: 0 12rpx 16rpx;
  overflow-x: auto;
}

.spec-switch-item {
  font-size: 22rpx;
  color: #8a7e6e;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(13, 10, 18, 0.6);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  white-space: nowrap;
}

.spec-switch-item.active {
  color: #f3e6c3;
  border-color: rgba(212, 168, 75, 0.5);
  background: rgba(212, 168, 75, 0.12);
}

/* ── Build Panel (2 column) ── */
.build-panel {
  display: flex;
  gap: 24rpx;
  padding: 0 4rpx;
}

.build-column {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

/* ── Slot Cell ── */
.slot-cell {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(13, 10, 18, 0.75);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  min-height: 108rpx;
}

.slot-cell.filled {
  border-color: rgba(212, 168, 75, 0.3);
}

.slot-cell:active {
  border-color: rgba(212, 168, 75, 0.6);
  background: rgba(20, 16, 26, 0.9);
}

.slot-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: rgba(28, 24, 34, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.slot-icon-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
}

.slot-icon-letter {
  font-size: 22rpx;
  color: #b55cff;
  font-weight: 700;
}

.slot-placeholder-text {
  font-size: 18rpx;
  color: #5a5248;
  font-weight: 600;
  text-align: center;
}

.slot-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.slot-item-name {
  font-size: 20rpx;
  color: #b55cff;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot-item-stat {
  font-size: 18rpx;
  color: #38f038;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot-item-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.slot-item-ilvl {
  font-size: 18rpx;
  color: #8a7e6e;
  font-weight: 600;
}

.slot-item-source {
  font-size: 18rpx;
  color: #5a5248;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.slot-empty-hint {
  font-size: 20rpx;
  color: #4a4439;
}

/* ── Weapon Row ── */
.build-weapon-row {
  display: flex;
  gap: 24rpx;
  padding: 14rpx 4rpx 0;
}

.weapon-slot {
  flex: 1;
}

.weapon-slot-disabled {
  opacity: 0.58;
}

/* ── Placeholder Slot (shirt/tabard) ── */
.placeholder-slot {
  opacity: 0.4;
  border-style: dashed;
  border-color: rgba(255, 255, 255, 0.08);
}

.placeholder-hint {
  color: #3a3530;
  text-align: center;
}

/* ── Bottom Stats ── */
.build-stats-bottom {
  margin: 20rpx 4rpx 0;
  padding: 24rpx 24rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(13, 10, 18, 0.82);
  border: 1rpx solid rgba(212, 168, 75, 0.25);
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.4);
}

.stats-bottom-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.stats-bottom-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #d4a84b;
  letter-spacing: 3rpx;
}

.stats-bottom-count {
  font-size: 24rpx;
  color: #5a5248;
  font-weight: 600;
}

.stats-bottom-secondary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx 0;
}

.stats-bottom-item {
  width: 50%;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 6rpx 0;
}

.stats-bottom-label {
  font-size: 26rpx;
  color: #a69882;
  font-weight: 700;
  flex-shrink: 0;
}

.stats-label-crit { color: #ff6b6b; }
.stats-label-haste { color: #ffd43b; }
.stats-label-mastery { color: #69b4ff; }
.stats-label-vers { color: #51cf66; }

.stats-bottom-value {
  font-size: 28rpx;
  color: #f3e6c3;
  font-weight: 800;
}

.stats-bottom-percent {
  font-size: 22rpx;
  color: #38f038;
  font-weight: 600;
}

.stats-bottom-total {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.stats-bottom-total-label {
  font-size: 26rpx;
  color: #8a7e6e;
  font-weight: 700;
}

.stats-bottom-total-value {
  font-size: 32rpx;
  color: #d4a84b;
  font-weight: 900;
}

.stats-bottom-primary {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 0;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.04);
}

/* ── Action Bar ── */
.build-action-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 12rpx 48rpx;
}

.build-action-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  padding: 20rpx 0;
  border-radius: 16rpx;
}

.build-action-clear {
  color: #e05050;
  background: rgba(224, 80, 80, 0.08);
  border: 1rpx solid rgba(224, 80, 80, 0.3);
}

.build-action-clear:active {
  background: rgba(224, 80, 80, 0.18);
}

.build-action-save {
  color: #52c41a;
  background: rgba(82, 196, 26, 0.1);
  border: 1rpx solid rgba(82, 196, 26, 0.4);
}

.build-action-save:active {
  background: rgba(82, 196, 26, 0.22);
}

.build-action-new {
  color: #d4a84b;
  background: rgba(212, 168, 75, 0.08);
  border: 1rpx solid rgba(212, 168, 75, 0.3);
}

.build-action-new:active {
  background: rgba(212, 168, 75, 0.18);
}

/* ── Popup ── */
.picker-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.78);
  display: flex;
  align-items: flex-end;
}

.picker-panel {
  width: 100%;
  max-height: 80vh;
  border-radius: 36rpx 36rpx 0 0;
  overflow: hidden;
  background: linear-gradient(180deg, #1d1822 0%, #110e15 100%);
  border-top: 2rpx solid rgba(212, 168, 75, 0.4);
  display: flex;
  flex-direction: column;
}

.picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  flex-shrink: 0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #f3e6c3;
  letter-spacing: 2rpx;
}

.picker-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #8a7e6e;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.04);
}

.picker-list {
  flex: 1;
  min-height: 0;
  padding: 0 20rpx 40rpx;
}

.picker-empty {
  padding: 64rpx 0;
  text-align: center;
  color: #5a5248;
  font-size: 26rpx;
}

/* ── Build List ── */
.build-list-panel {
  max-height: 70vh;
}

.build-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.build-list-item:active {
  background: rgba(212, 168, 75, 0.08);
  border-radius: 12rpx;
}

.build-list-item-body {
  flex: 1;
  min-width: 0;
}

.build-list-item-name {
  font-size: 28rpx;
  color: #f3e6c3;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.build-list-item-meta {
  font-size: 22rpx;
  color: #8a7e6e;
  margin-top: 4rpx;
}

.build-list-item-actions {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.build-list-delete {
  font-size: 22rpx;
  color: #e05050;
  padding: 8rpx 16rpx;
  border: 1rpx solid rgba(224, 80, 80, 0.3);
  border-radius: 12rpx;
}

.build-list-delete:active {
  background: rgba(224, 80, 80, 0.15);
}
