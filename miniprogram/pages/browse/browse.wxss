.browse-page {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 24rpx;
  background: #000;
}

.browse-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 0 48rpx;
}

.browse-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #f3e6c3;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.8);
}

.browse-subtitle {
  font-size: 24rpx;
  color: var(--text-soft);
  margin-top: 14rpx;
  letter-spacing: 3rpx;
}

.class-grid-wrap {
  width: 100%;
  padding: 0 8rpx;
}

.class-row {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.class-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 20rpx;
  border-radius: 24rpx;
  background: rgba(13, 10, 18, 0.82);
  border: 1rpx solid rgba(212, 168, 75, 0.25);
  box-shadow:
    0 12rpx 28rpx rgba(0, 0, 0, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  transition: transform 0.15s, border-color 0.15s;
}

.class-cell:active {
  transform: scale(0.95);
  border-color: rgba(212, 168, 75, 0.6);
  background: rgba(20, 16, 26, 0.92);
}

.class-emblem {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(0, 0, 0, 0.4));
}

.class-label {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.8);
  text-align: center;
}
