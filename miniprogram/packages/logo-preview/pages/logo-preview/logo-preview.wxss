.logo-preview-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx 28rpx 64rpx;
  color: #f7e8bd;
  background:
    linear-gradient(90deg, rgba(219, 170, 58, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(rgba(219, 170, 58, 0.03) 1rpx, transparent 1rpx),
    #09080d;
  background-size: 36rpx 36rpx;
}

.logo-preview-intro {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 8rpx 32rpx;
}

.logo-preview-eyebrow,
.logo-preview-card-name {
  color: #b89042;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.logo-preview-heading {
  color: #f7e8bd;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.logo-preview-description {
  color: #9a907f;
  font-size: 24rpx;
  line-height: 1.7;
}

.logo-preview-card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(210, 164, 64, 0.28);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(43, 32, 17, 0.9), rgba(16, 13, 19, 0.96));
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.28);
}

.logo-preview-forge-stage,
.logo-preview-rune-stage {
  position: relative;
  display: flex;
  box-sizing: border-box;
  min-height: 270rpx;
  margin-top: 18rpx;
  padding: 34rpx 16rpx 28rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.logo-preview-forge-medal,
.logo-preview-forge-medal-core,
.logo-preview-utility-mark,
.logo-preview-utility-mark-inner,
.logo-preview-rune-diamond {
  box-sizing: border-box;
  transform: rotate(45deg);
}

.logo-preview-forge-medal {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e7bd58;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 14rpx rgba(232, 184, 72, 0.55);
}

.logo-preview-forge-medal-core {
  width: 16rpx;
  height: 16rpx;
  border: 2rpx solid #7f4fe0;
  background: #d4a744;
}

.logo-preview-forge-rule {
  position: absolute;
  top: 109rpx;
  width: 24%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c79a3c);
}

.logo-preview-forge-rule-left {
  left: 1%;
}

.logo-preview-forge-rule-right {
  right: 1%;
  transform: scaleX(-1);
}

.logo-preview-forge-title,
.logo-preview-rune-title {
  position: relative;
  z-index: 1;
  color: #f5cc6a;
  font-family: serif;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  text-shadow: 2rpx 2rpx 0 #2d180b, 4rpx 5rpx 8rpx rgba(0, 0, 0, 0.8);
}

.logo-preview-forge-subtitle-row {
  display: flex;
  width: 100%;
  margin-top: 22rpx;
  align-items: center;
  gap: 12rpx;
}

.logo-preview-forge-subtitle-line {
  height: 1rpx;
  flex: 1;
  background: linear-gradient(90deg, transparent, #a3772b);
}

.logo-preview-forge-subtitle-line:last-child {
  transform: scaleX(-1);
}

.logo-preview-forge-subtitle,
.logo-preview-rune-subtitle {
  color: #be913b;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  white-space: nowrap;
}

.logo-preview-utility-stage {
  display: flex;
  box-sizing: border-box;
  min-height: 190rpx;
  margin-top: 18rpx;
  padding: 24rpx 18rpx;
  align-items: center;
  border-left: 4rpx solid #b18331;
  background: rgba(6, 6, 10, 0.38);
}

.logo-preview-utility-mark {
  display: flex;
  width: 42rpx;
  height: 42rpx;
  margin: 0 30rpx 0 10rpx;
  border: 2rpx solid #ebc662;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 12rpx rgba(235, 198, 98, 0.35);
}

.logo-preview-utility-mark-inner {
  width: 16rpx;
  height: 16rpx;
  background: #7143b0;
}

.logo-preview-utility-divider {
  width: 1rpx;
  height: 84rpx;
  margin-right: 28rpx;
  background: linear-gradient(transparent, #d8ac52, transparent);
}

.logo-preview-utility-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 10rpx;
}

.logo-preview-utility-title {
  color: #f5cc6a;
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
  text-shadow: 2rpx 2rpx 0 #2d180b, 4rpx 5rpx 8rpx rgba(0, 0, 0, 0.8);
}

.logo-preview-utility-subtitle {
  color: #c59b46;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.logo-preview-rune-stage {
  min-height: 300rpx;
  padding-top: 58rpx;
}

.logo-preview-rune-frame {
  position: absolute;
  box-sizing: border-box;
  border: 1rpx solid rgba(214, 172, 77, 0.72);
}

.logo-preview-rune-frame-outer {
  top: 18rpx;
  right: 6rpx;
  bottom: 18rpx;
  left: 6rpx;
}

.logo-preview-rune-frame-inner {
  top: 30rpx;
  right: 18rpx;
  bottom: 30rpx;
  left: 18rpx;
  border-color: rgba(137, 99, 42, 0.72);
}

.logo-preview-rune-corner {
  position: absolute;
  z-index: 1;
  width: 13rpx;
  height: 13rpx;
  border: 1rpx solid #e4bd63;
  background: #171015;
  transform: rotate(45deg);
}

.logo-preview-rune-corner-top-left {
  top: 13rpx;
  left: 1rpx;
}

.logo-preview-rune-corner-top-right {
  top: 13rpx;
  right: 1rpx;
}

.logo-preview-rune-corner-bottom-left {
  bottom: 13rpx;
  left: 1rpx;
}

.logo-preview-rune-corner-bottom-right {
  right: 1rpx;
  bottom: 13rpx;
}

.logo-preview-rune-diamond {
  width: 20rpx;
  height: 20rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #d9a944;
  background: #6a43ac;
  box-shadow: 0 0 14rpx rgba(126, 75, 191, 0.6);
}

.logo-preview-rune-divider {
  width: 42%;
  height: 1rpx;
  margin: 20rpx 0 16rpx;
  background: linear-gradient(90deg, transparent, #d4a748, transparent);
}

.logo-preview-back {
  box-sizing: border-box;
  width: 100%;
  margin-top: 8rpx;
  border: 1rpx solid rgba(232, 190, 88, 0.6);
  border-radius: 12rpx;
  color: #f2d795;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #5d421b, #20160d);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.32);
}

.logo-preview-back::after {
  border: 0;
}
