.logo-preview-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx 28rpx 64rpx;
  color: #f7e8bd;
  background:
    linear-gradient(90deg, rgba(217, 169, 68, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(rgba(217, 169, 68, 0.03) 1rpx, transparent 1rpx),
    #09080d;
  background-size: 36rpx 36rpx;
}

.logo-preview-intro {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 8rpx 32rpx;
}

.logo-preview-eyebrow,
.logo-preview-card-name {
  color: #b18331;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.logo-preview-heading {
  color: #f7e8bd;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.logo-preview-description {
  color: #c59b46;
  font-size: 24rpx;
  line-height: 1.7;
}

.logo-preview-card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(197, 155, 70, 0.48);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(45, 24, 11, 0.94), rgba(23, 16, 21, 0.98));
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.42);
}

.logo-preview-metal-stage {
  display: flex;
  box-sizing: border-box;
  min-height: 190rpx;
  margin-top: 16rpx;
  padding: 26rpx 0 18rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
}

.logo-preview-metal-title-stack {
  position: relative;
  width: 100%;
  height: 80rpx;
  text-align: center;
}

.logo-preview-title-depth,
.logo-preview-title-mid,
.logo-preview-title-face {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  line-height: 1.15;
  text-align: center;
  white-space: nowrap;
}

.logo-preview-title-depth {
  color: #2d180b;
}

.logo-preview-title-mid {
  color: #c79a3c;
}

.logo-preview-title-face {
  color: #f5cc6a;
}

.logo-preview-metal-hard .logo-preview-title-depth {
  transform: translateY(7rpx);
  text-shadow: 0 3rpx 0 #09080d, 3rpx 6rpx 8rpx rgba(0, 0, 0, 0.82);
}

.logo-preview-metal-hard .logo-preview-title-mid {
  transform: translateY(3rpx);
  text-shadow: 0 2rpx 0 #7a4d18;
}

.logo-preview-metal-hard .logo-preview-title-face {
  text-shadow: 0 1rpx 0 #fff0c9, 0 4rpx 0 #9a6a24, 2rpx 6rpx 10rpx rgba(0, 0, 0, 0.7);
}

.logo-preview-metal-glow .logo-preview-title-depth {
  transform: translateY(5rpx);
  text-shadow: 0 4rpx 0 #09080d, 0 7rpx 12rpx rgba(0, 0, 0, 0.78);
}

.logo-preview-metal-glow .logo-preview-title-mid {
  transform: translateY(2rpx);
  color: #e7bd58;
  text-shadow: 0 2rpx 0 #7a4d18, 0 0 10rpx rgba(242, 215, 149, 0.38);
}

.logo-preview-metal-glow .logo-preview-title-face {
  color: #fff0c9;
  text-shadow: 0 1rpx 0 #f7e8bd, 0 3rpx 0 #be913b, 0 0 14rpx rgba(242, 215, 149, 0.52), 2rpx 6rpx 10rpx rgba(0, 0, 0, 0.64);
}

.logo-preview-metal-etched .logo-preview-title-depth {
  transform: translateY(8rpx);
  text-shadow: 0 3rpx 0 #09080d, 4rpx 7rpx 8rpx rgba(0, 0, 0, 0.88);
}

.logo-preview-metal-etched .logo-preview-title-mid {
  transform: translateY(4rpx);
  color: #9a6a24;
  text-shadow: 0 2rpx 0 #5d421b;
}

.logo-preview-metal-etched .logo-preview-title-face {
  color: #e7bd58;
  text-shadow: 0 -1rpx 0 #fff0c9, 0 2rpx 0 #7a4d18, 0 5rpx 0 #3b2614, 2rpx 7rpx 9rpx rgba(0, 0, 0, 0.76);
}

.logo-preview-metal-footer {
  display: flex;
  width: 100%;
  margin-top: 22rpx;
  align-items: center;
  gap: 10rpx;
}

.logo-preview-metal-rule {
  height: 1rpx;
  flex: 1;
  background: linear-gradient(90deg, transparent, #7a4d18 22%, #d8ac52 72%, transparent);
  box-shadow: 0 0 6rpx rgba(217, 169, 68, 0.32);
}

.logo-preview-mirror {
  transform: scaleX(-1);
}

.logo-preview-metal-diamond {
  box-sizing: border-box;
  width: 9rpx;
  height: 9rpx;
  flex: 0 0 auto;
  border: 1rpx solid #fff0c9;
  background: #d9a944;
  transform: rotate(45deg);
  box-shadow: 0 0 5rpx rgba(217, 169, 68, 0.62);
}

.logo-preview-subtitle {
  color: #e4bd63;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  white-space: nowrap;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.6);
}

.logo-preview-back {
  box-sizing: border-box;
  width: 100%;
  margin-top: 8rpx;
  border: 1rpx solid rgba(228, 189, 99, 0.6);
  border-radius: 12rpx;
  color: #f2d795;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #5d421b, #20160d);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.32);
}

.logo-preview-back::after {
  border: 0;
}
