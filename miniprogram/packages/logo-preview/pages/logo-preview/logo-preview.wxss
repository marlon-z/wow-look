.logo-preview-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 42rpx 28rpx 64rpx;
  color: #f7e8bd;
  background:
    linear-gradient(90deg, rgba(217, 169, 68, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(rgba(217, 169, 68, 0.03) 1rpx, transparent 1rpx),
    #09080d;
  background-size: 36rpx 36rpx;
}

.logo-preview-intro {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 0 8rpx 32rpx;
}

.logo-preview-eyebrow,
.logo-preview-card-name {
  color: #b18331;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.logo-preview-heading {
  color: #f7e8bd;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.logo-preview-description {
  color: #c59b46;
  font-size: 24rpx;
  line-height: 1.7;
}

.logo-preview-card {
  box-sizing: border-box;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(197, 155, 70, 0.48);
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(45, 24, 11, 0.94), rgba(23, 16, 21, 0.98));
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.42);
}

.logo-preview-crown-stage,
.logo-preview-blades-stage,
.logo-preview-temple-stage,
.logo-preview-dual-line-stage {
  position: relative;
  display: flex;
  box-sizing: border-box;
  min-height: 254rpx;
  margin-top: 18rpx;
  padding: 30rpx 8rpx 26rpx;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.logo-preview-display-title,
.logo-preview-compact-title {
  position: relative;
  z-index: 1;
  color: #f5cc6a;
  font-size: 60rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  text-shadow: 2rpx 2rpx 0 #2d180b, 4rpx 5rpx 8rpx rgba(0, 0, 0, 0.8);
}

.logo-preview-compact-title {
  font-size: 48rpx;
  letter-spacing: 5rpx;
}

.logo-preview-subtitle-row,
.logo-preview-blades-footer,
.logo-preview-dual-line-bottom {
  display: flex;
  width: 100%;
  margin-top: 22rpx;
  align-items: center;
  gap: 12rpx;
}

.logo-preview-subtitle {
  color: #e4bd63;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.logo-preview-subtitle-rule,
.logo-preview-blades-footer-line {
  height: 1rpx;
  flex: 1;
  background: linear-gradient(90deg, transparent, #c79a3c);
}

.logo-preview-mirror {
  transform: scaleX(-1);
}

.logo-preview-crown-crest {
  position: relative;
  display: flex;
  width: 172rpx;
  height: 74rpx;
  margin-bottom: 10rpx;
  align-items: flex-end;
  justify-content: center;
}

.logo-preview-crown-spire {
  position: absolute;
  bottom: 9rpx;
  width: 0;
  height: 0;
  border-width: 0 16rpx 52rpx;
  border-style: solid;
  border-color: transparent transparent #d4a744;
}

.logo-preview-crown-spire-left { left: 31rpx; transform: rotate(-16deg); }
.logo-preview-crown-spire-center { bottom: 1rpx; border-width: 0 20rpx 66rpx; border-bottom-color: #f2d795; }
.logo-preview-crown-spire-right { right: 31rpx; transform: rotate(16deg); }

.logo-preview-crown-wing {
  position: absolute;
  bottom: 10rpx;
  width: 48rpx;
  height: 24rpx;
  border-top: 3rpx solid #be913b;
}

.logo-preview-crown-wing-left { left: 0; transform: skewY(26deg); }
.logo-preview-crown-wing-right { right: 0; transform: skewY(-26deg); }

.logo-preview-crown-amber,
.logo-preview-blades-diamond,
.logo-preview-blades-footer-diamond,
.logo-preview-column-mark-gem {
  box-sizing: border-box;
  background: #d9a944;
  transform: rotate(45deg);
}

.logo-preview-crown-amber {
  position: absolute;
  bottom: 0;
  width: 17rpx;
  height: 17rpx;
  border: 2rpx solid #fff0c9;
  box-shadow: 0 0 14rpx rgba(217, 169, 68, 0.68);
}

.logo-preview-crown-title-row {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 12rpx;
}

.logo-preview-crown-rule {
  height: 4rpx;
  flex: 1;
  background: linear-gradient(90deg, transparent, #7a4d18 32%, #f2d795 78%, transparent);
  box-shadow: 0 0 10rpx rgba(217, 169, 68, 0.35);
}

.logo-preview-blades-mark {
  position: relative;
  width: 162rpx;
  height: 76rpx;
  margin-bottom: 10rpx;
}

.logo-preview-blade {
  position: absolute;
  top: 28rpx;
  width: 92rpx;
  height: 9rpx;
  border: 1rpx solid #fff0c9;
  background: linear-gradient(90deg, #7a4d18, #e7bd58, #5d421b);
  box-shadow: 0 0 9rpx rgba(228, 189, 99, 0.42);
}

.logo-preview-blade-left { left: 10rpx; transform: rotate(31deg); }
.logo-preview-blade-right { right: 10rpx; transform: rotate(-31deg); }

.logo-preview-blades-diamond {
  position: absolute;
  top: 23rpx;
  left: 68rpx;
  width: 27rpx;
  height: 27rpx;
  border: 2rpx solid #f7e8bd;
  box-shadow: 0 0 16rpx rgba(217, 169, 68, 0.62);
}

.logo-preview-blades-footer { margin-top: 25rpx; gap: 10rpx; }
.logo-preview-blades-footer-diamond { width: 9rpx; height: 9rpx; flex: 0 0 auto; }

.logo-preview-temple-stage { min-height: 274rpx; padding-top: 52rpx; }

.logo-preview-temple-arch {
  position: absolute;
  box-sizing: border-box;
  top: 14rpx;
  width: 168rpx;
  height: 104rpx;
  border: 2rpx solid #c79a3c;
  border-bottom: 0;
  border-radius: 90rpx 90rpx 0 0;
}

.logo-preview-temple-arch-inner {
  top: 28rpx;
  width: 138rpx;
  height: 82rpx;
  border-color: #7a4d18;
}

.logo-preview-temple-seal {
  position: absolute;
  top: 33rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #f2d795;
  border-radius: 50%;
  align-items: center;
  justify-content: center;
  background: #3b2614;
}

.logo-preview-temple-seal-core {
  width: 15rpx;
  height: 15rpx;
  border: 2rpx solid #d9a944;
  transform: rotate(45deg);
}

.logo-preview-temple-plaque {
  box-sizing: border-box;
  width: 100%;
  padding: 16rpx 8rpx;
  border-top: 2rpx solid #be913b;
  border-bottom: 2rpx solid #be913b;
  background: linear-gradient(90deg, transparent, rgba(93, 66, 27, 0.86), transparent);
}

.logo-preview-badge-stage,
.logo-preview-column-stage {
  display: flex;
  box-sizing: border-box;
  min-height: 180rpx;
  margin-top: 18rpx;
  padding: 24rpx 14rpx;
  align-items: center;
}

.logo-preview-badge-shield {
  position: relative;
  box-sizing: border-box;
  width: 78rpx;
  height: 90rpx;
  margin-right: 28rpx;
  border: 3rpx solid #e7bd58;
  border-radius: 10rpx 10rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #5d421b, #20160d);
  box-shadow: 0 0 14rpx rgba(228, 189, 99, 0.36);
}

.logo-preview-badge-shield::after {
  position: absolute;
  top: 13rpx;
  left: 24rpx;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid #fff0c9;
  content: '';
  transform: rotate(45deg);
}

.logo-preview-badge-shield-core {
  position: absolute;
  bottom: 15rpx;
  left: 28rpx;
  width: 16rpx;
  height: 16rpx;
  background: #d9a944;
  transform: rotate(45deg);
}

.logo-preview-badge-divider {
  width: 2rpx;
  height: 92rpx;
  margin-right: 24rpx;
  background: linear-gradient(transparent, #d8ac52, transparent);
}

.logo-preview-badge-copy,
.logo-preview-column-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.logo-preview-badge-copy-rule,
.logo-preview-column-title-rule {
  width: 100%;
  height: 2rpx;
  background: linear-gradient(90deg, #c79a3c, transparent);
}

.logo-preview-dual-line-stage { min-height: 216rpx; }

.logo-preview-dual-line-top,
.logo-preview-dual-line-bottom {
  display: flex;
  width: 100%;
  align-items: center;
  gap: 12rpx;
}

.logo-preview-dual-line-top { margin-bottom: 14rpx; }
.logo-preview-dual-line-bottom { margin-top: 20rpx; }

.logo-preview-dual-line-rule {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #d4a744);
}

.logo-preview-dual-line-rule-long { flex: 1.7; }
.logo-preview-dual-line-rule-short { flex: 1; }

.logo-preview-dual-line-medal {
  display: flex;
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  border: 2rpx solid #f2d795;
  transform: rotate(45deg);
  align-items: center;
  justify-content: center;
}

.logo-preview-dual-line-medal view {
  width: 10rpx;
  height: 10rpx;
  background: #d9a944;
}

.logo-preview-column-stage {
  min-height: 170rpx;
  padding-left: 0;
  border-left: 5rpx solid #be913b;
  background: rgba(32, 22, 13, 0.66);
}

.logo-preview-column-mark {
  display: flex;
  box-sizing: border-box;
  width: 70rpx;
  height: 110rpx;
  margin: 0 24rpx 0 18rpx;
  border: 1rpx solid #d8ac52;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  gap: 13rpx;
}

.logo-preview-column-mark-top,
.logo-preview-column-mark-bottom {
  width: 34rpx;
  height: 14rpx;
  border-top: 2rpx solid #e7bd58;
  border-bottom: 2rpx solid #7a4d18;
}

.logo-preview-column-mark-gem {
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid #f7e8bd;
}

.logo-preview-column-title-rule { background: linear-gradient(90deg, #be913b, #7a4d18, transparent); }

.logo-preview-back {
  box-sizing: border-box;
  width: 100%;
  margin-top: 8rpx;
  border: 1rpx solid rgba(228, 189, 99, 0.6);
  border-radius: 12rpx;
  color: #f2d795;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #5d421b, #20160d);
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.32);
}

.logo-preview-back::after { border: 0; }
