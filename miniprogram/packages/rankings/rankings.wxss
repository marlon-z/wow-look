page {
  background-color: #050406;
  background-image:
    linear-gradient(rgba(212, 168, 75, 0.03) 1.5rpx, transparent 1.5rpx),
    linear-gradient(90deg, rgba(212, 168, 75, 0.03) 1.5rpx, transparent 1.5rpx);
  background-size: 55rpx 55rpx;
  background-attachment: fixed;
  color: #e8e4dc;
}

.rankings-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 64rpx;
  background: #09070d;
}

/* Phase 1: Class Picker Screen */
.rankings-picker-page {
  padding: 0 24rpx 48rpx;
  background: transparent;
}

.ranking-picker-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 0 48rpx;
}

.ranking-picker-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #f3e6c3;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.8);
}

.ranking-picker-subtitle {
  margin-top: 14rpx;
  color: var(--text-soft, #9e9688);
  font-size: 24rpx;
  letter-spacing: 3rpx;
}

.ranking-class-grid-wrap {
  width: 100%;
  padding: 0 8rpx;
}

.ranking-class-row {
  display: flex;
  justify-content: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.ranking-class-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 20rpx;
  border: 1rpx solid rgba(212, 168, 75, 0.25);
  border-radius: 24rpx;
  background: rgba(13, 10, 18, 0.82);
  box-shadow:
    0 12rpx 28rpx rgba(0, 0, 0, 0.42),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.05);
  transition: transform 0.15s, border-color 0.15s;
}

.ranking-class-cell:active {
  transform: scale(0.95);
  border-color: rgba(212, 168, 75, 0.6);
  background: rgba(20, 16, 26, 0.92);
}

.ranking-picker-emblem {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 24rpx;
  filter: drop-shadow(0 4rpx 10rpx rgba(0, 0, 0, 0.4));
}

.ranking-picker-label {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.8);
}


/* Phase 2: Rankings List Screen */
.ranking-header {
  margin-bottom: 24rpx;
  padding-top: 8rpx;
}

.ranking-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.ranking-back {
  display: inline-flex;
  align-items: center;
  height: 52rpx;
  padding: 0 16rpx 0 8rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #c9b795;
  font-size: 24rpx;
  font-weight: 700;
  transition: background 0.15s;
}

.ranking-back:active {
  background: rgba(255, 255, 255, 0.1);
}

.ranking-back-arrow {
  margin-right: 6rpx;
  font-size: 34rpx;
  line-height: 1;
  color: #d4a84b;
}

.ranking-update {
  font-size: 22rpx;
  color: #8c8477;
  font-weight: 500;
}

.ranking-class-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
}

.ranking-class-emblem {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.ranking-title-wrap {
  display: flex;
  flex-direction: column;
}

.ranking-title {
  color: #f3e6c3;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
}

.ranking-class-name {
  color: #d4a84b;
  font-size: 23rpx;
  font-weight: 700;
  margin-top: 2rpx;
}

/* Spec Bar */
.spec-bar {
  display: flex;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.spec-pill {
  flex: 1;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  color: #a9a097;
  font-size: 26rpx;
  font-weight: 700;
  transition: all 0.15s ease;
}

.spec-pill.active {
  color: #ffd05a;
  border-color: rgba(212, 168, 75, 0.6);
  background: rgba(212, 168, 75, 0.18);
  font-weight: 900;
}

.spec-pill:active {
  transform: scale(0.97);
}

/* Filter Panel (Simplified, clean, spacious) */
.ranking-filter-panel {
  margin-bottom: 32rpx;
}

.filter-top-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.content-tabs {
  display: flex;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 4rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
}

.content-tab {
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8c8477;
  font-size: 24rpx;
  font-weight: 700;
  transition: all 0.15s ease;
}

.content-tab.active {
  color: #ffd05a;
  background: rgba(212, 168, 75, 0.22);
  font-weight: 900;
}

.level-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.level-row {
  display: inline-flex;
  gap: 12rpx;
}

.compact-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.035);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  color: #a9a097;
  font-size: 23rpx;
  font-weight: 600;
  flex-shrink: 0;
  transition: all 0.15s ease;
}

.compact-pill.active {
  color: #ffd05a;
  border-color: rgba(212, 168, 75, 0.6);
  background: rgba(212, 168, 75, 0.16);
  font-weight: 800;
}

.dungeon-scroll {
  width: 100%;
  white-space: nowrap;
  padding-top: 4rpx;
}

.dungeon-row {
  display: inline-flex;
  gap: 12rpx;
}

.dungeon-pill {
  color: #8c8477;
}

.dungeon-pill.active {
  color: #ffd05a;
}

/* Query-page visual system for the ranking detail header and filters. */
.ranking-detail-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  margin: -24rpx -24rpx 16rpx;
  padding: 14rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  background: rgba(15, 12, 19, 0.82);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.ranking-detail-back,
.ranking-detail-top-spacer {
  width: 52rpx;
  height: 52rpx;
}

.ranking-detail-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  color: #e8e4dc;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.ranking-detail-top-title {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  align-items: center;
  gap: 12rpx;
  transform: translate(-50%, -50%);
}

.ranking-detail-top-emblem {
  width: 46rpx;
  height: 46rpx;
}

.ranking-detail-top-name {
  color: #ffbb12;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  white-space: nowrap;
}

.ranking-hero-panel {
  position: relative;
  min-height: 210rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  background: #141018;
  box-shadow: 0 16rpx 36rpx rgba(0, 0, 0, 0.4);
}

.ranking-hero-banner,
.ranking-hero-shade {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.ranking-hero-shade {
  background:
    linear-gradient(90deg, rgba(20, 16, 24, 0.98) 0%, rgba(20, 16, 24, 0.85) 48%, rgba(20, 16, 24, 0.18) 100%),
    linear-gradient(180deg, rgba(20, 16, 24, 0.72) 0%, rgba(20, 16, 24, 0) 35%);
}

.ranking-hero-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 210rpx;
  padding: 38rpx 32rpx 30rpx;
}

.ranking-hero-title {
  color: #ffbb12;
  font-size: 46rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.ranking-hero-subtitle {
  margin-top: 10rpx;
  color: #c9c3ba;
  font-size: 26rpx;
  font-weight: 600;
}

.ranking-hero-update {
  margin-top: 12rpx;
  color: #3fc7eb;
  font-size: 21rpx;
  font-weight: 600;
}

.ranking-query-filter-panel {
  margin-top: -8rpx;
  margin-bottom: 32rpx;
  padding: 18rpx 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(19, 18, 25, 0.985), rgba(17, 16, 23, 0.985));
  box-shadow: 0 18rpx 40rpx rgba(0, 0, 0, 0.35), inset 0 1rpx 0 rgba(255, 255, 255, 0.04);
}

.ranking-query-filter-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.ranking-query-filter-row-last {
  padding-bottom: 8rpx;
}

.ranking-query-filter-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
  width: 126rpx;
  height: 60rpx;
  color: #ffbb12;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.ranking-query-filter-mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffbb12;
  box-shadow: 0 0 10rpx rgba(255, 187, 18, 0.5);
}

.ranking-query-chip-grid {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  gap: 14rpx 12rpx;
}

.ranking-query-chip-scroll {
  flex: 1;
  width: 0;
  white-space: nowrap;
}

.ranking-query-chip-scroll-wrap {
  display: inline-flex;
  gap: 14rpx;
}

.ranking-query-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 104rpx;
  height: 60rpx;
  padding: 0 22rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  background: transparent;
  color: #d0cbc4;
  font-size: 22rpx;
  font-weight: 600;
  white-space: nowrap;
}

.ranking-query-chip.active {
  border-color: #ffbb12;
  background: rgba(255, 187, 18, 0.1);
  color: #ffbb12;
  box-shadow: inset 0 0 12rpx rgba(255, 187, 18, 0.05);
}

.ranking-query-chip:active {
  transform: scale(0.97);
}

/* Loading & Empty States */
.ranking-state {
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  color: #877c70;
  font-size: 25rpx;
}

.loading-orb {
  width: 36rpx;
  height: 36rpx;
  border: 3rpx solid rgba(212, 168, 75, 0.16);
  border-top-color: #d4a84b;
  border-radius: 50%;
  animation: ranking-spin 0.8s linear infinite;
}

@keyframes ranking-spin {
  to { transform: rotate(360deg); }
}

/* Preset Cards List */
.preset-list {
  padding-top: 8rpx;
}

.preset-group {
  margin-bottom: 28rpx;
}

.preset-group-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 4rpx 18rpx;
}

.preset-group-bullet {
  width: 6rpx;
  height: 24rpx;
  border-radius: 4rpx;
  background: #d4a84b;
}

.preset-group-title {
  color: #e3c47a;
  font-size: 26rpx;
  font-weight: 800;
}

.preset-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 120rpx;
  margin-bottom: 14rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(22, 18, 28, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25);
  transition: transform 0.12s, border-color 0.12s, background 0.12s;
}

.preset-card:active {
  transform: scale(0.988);
  border-color: rgba(212, 168, 75, 0.5);
  background: rgba(30, 24, 38, 0.96);
}

.preset-card-body {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.preset-card-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.preset-name {
  font-size: 29rpx;
  font-weight: 800;
  color: #c56cff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 340rpx;
}

.preset-badges {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.preset-score-badge {
  font-size: 21rpx;
  font-weight: 800;
  color: #ffd05a;
  background: rgba(212, 168, 75, 0.16);
  border: 1rpx solid rgba(212, 168, 75, 0.35);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.2;
}

.preset-diff-badge {
  font-size: 21rpx;
  font-weight: 700;
  color: #9e9588;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  line-height: 1.2;
}

.preset-card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8e8578;
}

.preset-metric {
  color: #c2b7a6;
  font-weight: 600;
}

.preset-server-divider {
  color: #554e44;
}

.preset-server {
  color: #8e8578;
}

.preset-card-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.preset-share-wrap {
  position: relative;
  box-sizing: border-box;
  flex-shrink: 0;
  width: 124rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: rgba(212, 168, 75, 0.08);
  border: 1rpx solid rgba(212, 168, 75, 0.28);
}

.preset-share-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.preset-share-wrap:active {
  background: rgba(212, 168, 75, 0.2);
  transform: scale(0.95);
}

.preset-share-label {
  text-align: center;
  white-space: nowrap;
  color: #d4a84b;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.preset-share-trigger {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;
  min-height: 0 !important;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  opacity: 0;
}

.preset-share-trigger::after { border: 0; }

.preset-apply-arrow {
  font-size: 32rpx;
  color: #6e6559;
  font-weight: 300;
  line-height: 1;
  margin-left: 2rpx;
}
